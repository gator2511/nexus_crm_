# Copy to .env and adjust. Never commit .env.
   DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus_crm
   PORT=4000
   JWT_SECRET=change-me-to-a-long-random-string
   APP_URL=http://localhost:5173
   SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
   RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
   MAIL_FROM=RIC Admissions <admissions@your-verified-domain.example>
   # Program brochure URL is stored in program.brochure_url in PostgreSQL.

# Public HTTPS URL for the student-facing frontend, without a trailing path.
# Required to email students one-time signup links after an enquiry.
PUBLIC_APP_URL=https://your-frontend-domain.example
